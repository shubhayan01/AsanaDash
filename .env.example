# ─────────────────────────────────────────────────────────────
#  Asana Dash — environment configuration
#  Copy this file to ".env" and fill in the values below.
#  NEVER commit your real .env file (it is git-ignored).
# ─────────────────────────────────────────────────────────────

# --- Login credentials (you choose these) ---
# The username + password ordinary users log in with to view the dashboard.
ADMIN_USER=admin
ADMIN_PASS=change-me-to-something-strong

# --- Developer login (optional but recommended) ---
# A separate, privileged account. Logging in with these lands on the Data
# Preloader page (/dev.html), where you fetch every project's tasks + time
# entries and save them to the server cache. After that, ordinary users open
# reports instantly. Leave DEV_PASS blank to disable the developer login.
DEV_USER=dev
DEV_PASS=change-me-too

# A long random string used to sign login session cookies.
# Generate one, e.g.:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# --- Asana ---
# Personal Access Token from https://app.asana.com/0/my-apps  ("Create new token")
ASANA_TOKEN=your-asana-personal-access-token

# --- Groq (AI) ---
# API key from https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# --- Server ---
# Local dev only. On Railway the platform injects PORT automatically —
# do NOT set it there.
PORT=3000
# Set to "true" when serving over HTTPS (marks the session cookie Secure).
# Local dev over http → false. On Railway (HTTPS) → true.
SECURE_COOKIE=false
